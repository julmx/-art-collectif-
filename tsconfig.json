{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "shared",
    "web/src",
    "server/src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "scripts"
  ]
}
